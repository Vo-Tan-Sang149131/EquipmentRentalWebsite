<configuration debug="true">
  <property name="LOG_DIR" value="${LOG_DIR:-/app/logs}"/>

  <!-- ==================== 1. APPENDER IN CONSOLE ==================== -->
  <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%X{traceId}] [%X{user}] [%X{ip}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ==================== 2. APPENDER GOM LỖI CHUYÊN BIỆT (MỚI) ==================== -->
  <!-- Chỉ giữ lại log WARN và ERROR của TOÀN BỘ hệ thống -->
  <appender name="ErrorFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/error.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <!-- Bộ lọc: Chỉ cho phép level WARN trở lên đi vào file này -->
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%X{traceId}] [%X{user}] [%X{ip}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ==================== 3. APPENDER LOG CHUNG ỨNG DỤNG ==================== -->
  <appender name="AppFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/app.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%X{traceId}] [%X{user}] [%X{ip}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ==================== 4. APPENDER AUTH (TRADITIONAL) ==================== -->
  <appender name="AuthFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/auth.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/auth.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%X{traceId}] [%X{user}] [%X{ip}] %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ==================== 5. APPENDER OAUTH2 ==================== -->
  <appender name="OAuthFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/oauth.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/oauth.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%X{traceId}] [%X{user}] [%X{ip}] %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ==================== 6. PHÂN LUỒNG LOGGER GHI FILE ==================== -->

  <!-- Luồng Auth: Đẩy vào Console, AuthFile và đồng thời đẩy cả lỗi vào ErrorFile -->
  <logger name="com.example.demo.service.auth" level="INFO" additivity="false">
    <appender-ref ref="Console"/>
    <appender-ref ref="AuthFile"/>
    <appender-ref ref="ErrorFile"/> <!-- Bổ sung để gom lỗi auth nếu có -->
  </logger>

  <!-- Luồng OAuth2: Đẩy vào Console, OAuthFile và đồng thời đẩy cả lỗi vào ErrorFile -->
  <logger name="com.example.demo.security.oauth2" level="INFO" additivity="false">
    <appender-ref ref="Console"/>
    <appender-ref ref="OAuthFile"/>
    <appender-ref ref="ErrorFile"/> <!-- Bổ sung để gom lỗi oauth2 nếu có -->
  </logger>

  <!-- Luồng Root mặc định toàn hệ thống -->
  <root level="INFO">
    <appender-ref ref="Console"/>
    <appender-ref ref="AppFile"/>
    <appender-ref ref="ErrorFile"/> <!-- Gom lỗi cho toàn bộ các phần còn lại -->
  </root>
</configuration>
