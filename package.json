{
  "name": "tmdt_n2_equipmentrentalwebsite",
  "version": "1.0.0",
  "description": "E-commerce Equipment Rental Website - Monorepo",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "// Docker Shortcuts": "-------------------------------------------------",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.override.yml up -d --build",
    "docker:prod": "docker-compose -f docker-compose.yml up -d --build",
    "docker:down": "docker-compose down -v",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "install:all": "npm install && npm install --workspaces",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force dist, node_modules -ErrorAction SilentlyContinue\"",
    "check-updates": "ncu -f nx",
    "// Act Local CI": "-------------------------------------------------",
    "Add artifact to stimulate server": "-------------------------------------------------",
    "docker:pull-act": "docker pull catthehacker/ubuntu:act-latest",
    "act:frontend": "powershell -Command \"Remove-Item -Recurse -Force ./artifacts -ErrorAction SilentlyContinue; npx dotenv-cli -- act -j frontend --secret-file .env --artifact-server-path ./artifacts --pull=false\"",
    "act:backend": "powershell -Command \"Remove-Item -Recurse -Force ./artifacts -ErrorAction SilentlyContinue; npx dotenv-cli -- act -j backend --secret-file .env --artifact-server-path ./artifacts --pull=false\"",
    "act:all": "powershell -Command \"Remove-Item -Recurse -Force ./artifacts -ErrorAction SilentlyContinue; npx dotenv-cli -- act --secret-file .env --artifact-server-path ./artifacts --pull=false\""
  },
  "keywords": [
    "monorepo",
    "ecommerce",
    "equipment-rental"
  ],
  "author": "Your Name",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "axios": "^1.16.1",
    "nx": "^23.0.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "form-data": "4.0.6",
    "js-yaml": "4.1.0",
    "tar": "7.5.16",
    "tmp": "0.2.7",
    "cosmiconfig": "9.0.1"
  },
  "devDependencies": {
    "@types/react-google-recaptcha": "^2.1.9",
    "minimatch": "^10.2.5",
    "rimraf": "^6.1.3"
  }
}
